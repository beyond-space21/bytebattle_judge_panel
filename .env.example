# Used by local/PM2 runs. Docker Compose sets its own service networking
# (see docker-compose.yml). Override secrets via:
#   ADMIN_PASSWORD=... JWT_SECRET=... docker compose up -d --build

DATABASE_URL=postgres://judge:judge@localhost:5432/judge?sslmode=disable
JUDGE0_URL=http://localhost:2358
HTTP_ADDR=:8759

# auto | judge0 | local
# Docker default (compose): local  |  make docker-full: auto
JUDGE_BACKEND=local

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=dev-jwt-secret-change-me
